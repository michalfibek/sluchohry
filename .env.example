# Copy to .env and adjust as needed. All values have working defaults
# so this file is optional — override only what you need to change.

# DB_NAME=sluchohry
# DB_USER=sluchohry
DB_PASSWORD=sluchohry
MYSQL_ROOT_PASSWORD=root

# Path to a gzipped SQL dump to import on first DB init (optional)
# DB_DUMP_FILE=/path/to/dump.sql.gz

# PHP version for the local dev image
# PHP_VERSION=8.4
