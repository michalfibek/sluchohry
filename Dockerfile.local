ARG PHP_VERSION=7.0
FROM php:${PHP_VERSION}-apache

ARG PHP_VERSION

# Older php:*-apache images are built on Debian releases that have since gone
# EOL, so their apt mirrors 404. Detect that and fall back to archive.debian.org
# using whatever codename this image actually is, instead of hardcoding one.
RUN set -eux; \
    if ! apt-get update; then \
      codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"; \
      if [ -z "$codename" ]; then \
        codename="$(. /etc/os-release && echo "$VERSION" | sed 's/.*(\(.*\)).*/\1/')"; \
      fi; \
      { echo "deb http://archive.debian.org/debian ${codename} main"; \
        echo "deb http://archive.debian.org/debian-security ${codename}/updates main"; \
      } > /etc/apt/sources.list; \
      echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid; \
      apt-get -o Acquire::AllowInsecureRepositories=true update; \
    fi; \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
      libpng-dev libjpeg62-turbo-dev libfreetype6-dev libicu-dev libzip-dev libonig-dev unzip git; \
    rm -rf /var/lib/apt/lists/*

# ext/gd's configure flags changed shape in PHP 7.4 (dropped the =DIR suffix)
RUN set -eux; \
    if dpkg --compare-versions "${PHP_VERSION}" lt "7.4"; then \
      docker-php-ext-configure gd --with-freetype-dir=/usr --with-jpeg-dir=/usr; \
    else \
      docker-php-ext-configure gd --with-freetype --with-jpeg; \
    fi; \
    docker-php-ext-install pdo_mysql mysqli mbstring gd intl zip

RUN { \
      echo 'memory_limit = 256M'; \
      echo 'upload_max_filesize = 20M'; \
      echo 'post_max_size = 20M'; \
      echo 'display_errors = On'; \
    } > /usr/local/etc/php/conf.d/zz-sluchohry.ini

# App's docroot is www/, not the repo root
RUN sed -ri -e 's!/var/www/html!/var/www/html/www!g' /etc/apache2/sites-available/*.conf /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf \
  && sed -ri -e 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
  && a2enmod rewrite

# Composer 2.3+ dropped support for PHP <7.2.5, so pick the right line for the target PHP version
COPY --from=composer:2.2 /usr/bin/composer /usr/local/bin/composer-2.2
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer-2
RUN if dpkg --compare-versions "${PHP_VERSION}" lt "7.2.5"; then \
      ln -sf /usr/local/bin/composer-2.2 /usr/bin/composer; \
    else \
      ln -sf /usr/local/bin/composer-2 /usr/bin/composer; \
    fi

WORKDIR /var/www/html

COPY docker/local-entrypoint.sh /usr/local/bin/local-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/local-entrypoint.sh && chmod +x /usr/local/bin/local-entrypoint.sh

ENTRYPOINT ["local-entrypoint.sh"]
CMD ["apache2-foreground"]
